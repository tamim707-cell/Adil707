//@version=6
// Research baseline, 2026-09-06. No profitability or execution guarantee.
// One overlay script: signals + risk planning + TradingView Strategy Tester.
// Defaults in Properties: capital 20000, commission 0.18% EACH SIDE,
// slippage 2 chart ticks. Keep cost inputs below aligned with Properties.
strategy("Adil Saudi TrendRisk v1 | عادل تريند ريسك", overlay = true,
     initial_capital = 20000, currency = currency.NONE,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, margin_long = 100, margin_short = 100,
     commission_type = strategy.commission.percent, commission_value = 0.18,
     slippage = 2, backtest_fill_limits_assumption = 1,
     process_orders_on_close = false, calc_on_every_tick = false,
     calc_on_order_fills = false, use_bar_magnifier = true,
     max_labels_count = 100)

// ---------- Inputs ----------
string G_RISK = "1 | إدارة المخاطر ورأس المال"
float riskPct = input.float(0.5, "نسبة المخاطرة لكل صفقة %", minval = 0.05, maxval = 1.0, group = G_RISK)
float allocationPct = input.float(50, "أقصى نسبة تخصيص لرأس المال للصفقة %", minval = 1, maxval = 100, group = G_RISK)
float dailyLossPct = input.float(1.0, "حد الخسارة اليومي % — لهذا الشارت فقط", minval = 0.1, maxval = 3, group = G_RISK)
float dayGoal = input.float(200, "هدف صافي الربح اليومي بالريال — للمتابعة فقط", minval = 1, group = G_RISK)
int maxEntriesDay = input.int(2, "أقصى عدد صفقات في اليوم لهذا الشارت", minval = 1, maxval = 5, group = G_RISK)
float netRR = input.float(2.0, "نسبة الهدف إلى المخاطرة بعد التكاليف", minval = 2, maxval = 5, group = G_RISK)
bool useBreakEven = input.bool(true, "رفع الوقف إلى نقطة التعادل بعد إغلاق فوق +1.5R", group = G_RISK)
float maxBarParticipation = input.float(1.0, "أقصى كمية كنسبة من حجم شمعة الإشارة %", minval = 0.1, maxval = 5, group = G_RISK)

string G_COST = "2 | التكاليف — طابقها مع Properties"
float feePct = input.float(0.18, "تكلفة كل جهة (شراء/بيع) % — طابقها مع عمولة وسيطك", minval = 0, maxval = 2, group = G_COST)
int reserveSlipTicks = input.int(2, "احتياطي الانزلاق (وقف/سوق) بوحدات التك", minval = 0, maxval = 50, group = G_COST)

string G_FILTER = "3 | فلاتر الإشارة"
string tasiSymbol = input.symbol("TADAWUL:TASI", "رمز المؤشر العام تاسي — فلتر إلزامي", group = G_FILTER)
float minDailyTurnoverM = input.float(10, "أدنى متوسط سيولة يومية — مليون ريال", minval = 1, step = 1, group = G_FILTER)
int breakoutLength = input.int(10, "عدد شموع قمة الاختراق — تستبعد الشمعة الحالية", minval = 3, maxval = 50, group = G_FILTER)
float volumeMultiple = input.float(1.3, "مضاعف الحجم مقابل متوسط 20 شمعة", minval = 1, maxval = 3, group = G_FILTER)
float maxTargetATR = input.float(6, "أقصى بُعد للهدف بوحدات ATR", minval = 2, maxval = 15, group = G_FILTER)
bool trendExitEnabled = input.bool(true, "الخروج بعد إغلاقين تحت EMA20", group = G_FILTER)

string G_TEST = "4 | الاختبار والعرض"
int fromTime = input.time(timestamp("29 Jun 2025 00:00 +0300"), "بداية فترة الاختبار — تبدأ من تفعيل قواعد التك", group = G_TEST)
int toTime = input.time(timestamp("31 Dec 2035 23:59 +0300"), "نهاية فترة الاختبار", group = G_TEST)
bool showPanel = input.bool(true, "عرض لوحة المعلومات", group = G_TEST)

// ---------- Supported charts and automatic timeframes ----------
bool is5 = timeframe.isminutes and timeframe.multiplier == 5
bool is15 = timeframe.isminutes and timeframe.multiplier == 15
bool is60 = timeframe.isminutes and timeframe.multiplier == 60
bool is1D = timeframe.isdaily and timeframe.multiplier == 1
bool dayMode = is5 or is15
string higherTF = is5 ? "15" : is15 ? "60" : is60 ? "1D" : "1W"
int maxHoldingBars = is5 ? 18 : is15 ? 12 : is60 ? 15 : 10
float maxStopPct = is5 ? 2.0 : is15 ? 3.0 : is60 ? 5.0 : 8.0
float maxStopATR = dayMode ? 2.5 : 3.0
int tickRulesStart = timestamp("29 Jun 2025 00:00 +0300")
if barstate.isfirst
    if not (is5 or is15 or is60 or is1D)
        runtime.error("استخدم إطار 5 أو 15 أو 60 دقيقة أو يوم واحد.")
    if not chart.is_standard
        runtime.error("استخدم شموع OHLC عادية، لا تستخدم Heikin Ashi أو Renko.")
    if syminfo.currency != "SAR" or syminfo.type != "stock"
        runtime.error("هذه النسخة للأسهم المسعّرة بالريال السعودي.")
    if toTime <= fromTime
        runtime.error("نهاية الاختبار يجب أن تكون بعد بدايته.")

// Saudi equity tick bands effective 2025-06-29. Update if exchange rules change.
f_tick(float p) =>
    p < 25 ? 0.01 : p < 50 ? 0.02 : p < 100 ? 0.05 : p < 250 ? 0.10 : p < 500 ? 0.20 : 0.50
f_down(float p) =>
    float t = f_tick(p)
    math.floor(p / t + 1e-8) * t
f_up(float p) =>
    float t = f_tick(p)
    math.ceil(p / t - 1e-8) * t
f_price(float p) =>
    na(p) ? "—" : str.tostring(p, "#.00")
f_money(float p) =>
    na(p) ? "—" : str.tostring(p, "#.00")

// ---------- One hypothesis: liquid breakout aligned with trend ----------
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float atr = ta.atr(14)
float breakoutHigh = ta.highest(high, breakoutLength)[1]
float priorVolumeMean = ta.sma(volume, 20)[1]
float swingLow = ta.lowest(low, 3)
float vwap = ta.vwap(hlc3, timeframe.change("1D"))

// All requested values are CLOSED bars. The [1] offsets must stay paired
// with lookahead_on. No developing HTF bar is used to approve an entry.
[htfClose, htfEMA] = request.security(syminfo.tickerid, higherTF, [close[1], ta.ema(close, 50)[1]], lookahead = barmerge.lookahead_on)
[tasiClose, tasiEMA] = request.security(tasiSymbol, higherTF, [close[1], ta.ema(close, 50)[1]], lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
float dailyTurnover = request.security(syminfo.tickerid, "1D", ta.sma(hlc3 * volume, 20)[1], lookahead = barmerge.lookahead_on)

bool ready = not na(ema50) and not na(atr) and atr > 0 and not na(htfEMA) and not na(tasiEMA) and not na(dailyTurnover) and not na(priorVolumeMean) and priorVolumeMean > 0 and not na(breakoutHigh)
bool marketOK = ready and tasiClose > tasiEMA
bool liquidityOK = ready and dailyTurnover >= minDailyTurnoverM * 1000000
bool trendOK = ready and ema20 > ema50 and close > ema20 and htfClose > htfEMA
bool vwapOK = not dayMode or (not na(vwap) and close > vwap)
bool volumeOK = ready and not na(volume) and volume >= priorVolumeMean * volumeMultiple
bool candleOK = high > low and close > open and (close - low) / math.max(high - low, syminfo.mintick) >= 0.65
bool breakoutOK = close > breakoutHigh and close[1] <= breakoutHigh
bool notChasing = close - breakoutHigh <= atr * 0.5 and close - ema20 <= atr * 2.0
bool setup = marketOK and liquidityOK and trendOK and vwapOK and volumeOK and candleOK and breakoutOK and notChasing

// Use actual chart close time, not time_close(session) synthetic boundaries.
int closeMinute = hour(time_close, "Asia/Riyadh") * 60 + minute(time_close, "Asia/Riyadh")
int riyadhWeekday = dayofweek(time, "Asia/Riyadh")
bool workday = riyadhWeekday >= dayofweek.sunday and riyadhWeekday <= dayofweek.thursday
bool entryWindow = is1D or (workday and closeMinute >= 630 and closeMinute <= 855)
bool flattenSession = dayMode and closeMinute >= 885
bool inTest = time >= math.max(fromTime, tickRulesStart) and time_close < toTime

// ---------- Daily limits: THIS script/symbol only; no broker account access ----------
int dateKey = year(time, "Asia/Riyadh") * 10000 + month(time, "Asia/Riyadh") * 100 + dayofmonth(time, "Asia/Riyadh")
bool newDay = barstate.isfirst or dateKey != dateKey[1]
var float dayStartNet = 0.0
var float dayStartEquity = 0.0
var int entriesToday = 0
var bool dayLocked = false
if newDay
    dayStartNet := nz(strategy.netprofit[1], 0)
    dayStartEquity := nz(strategy.equity[1], strategy.initial_capital)
    entriesToday := 0
    dayLocked := false

float dayRealized = strategy.netprofit - dayStartNet
float dayEquity = strategy.equity
float dayLossBudget = dayStartEquity * dailyLossPct / 100
bool dailyLossHit = dayRealized < -dayLossBudget and strategy.position_size != 0

// ---------- Entry logic: sizing + stop/target candidates ----------
var bool havePosition = strategy.position_size != 0
bool filledNow = strategy.position_size[1] == 0 and strategy.position_size != 0
bool closedNow = strategy.position_size[1] != 0 and strategy.position_size == 0
if filledNow
    havePosition := true
if closedNow
    havePosition := false
    dayLocked := dayRealized < -dayLossBudget

float fee = feePct / 100
float slip = reserveSlipTicks * syminfo.mintick
float entryLimit = f_down(breakoutHigh + syminfo.mintick)
float stopCandidate = f_down(swingLow - syminfo.mintick)
float priceRisk = entryLimit - stopCandidate
float lossPerShare = priceRisk * (1 + fee) + slip
float targetCandidate = f_up(entryLimit + atr * (entryLimit - stopCandidate) / priceRisk * netRR)
// FIX: reward per share must use the TARGET exit, not the stop. It also had to
// move below targetCandidate so it can reference it. Net proceeds at target
// (after exit fee) minus entry price and slippage.
float profitPerShare = (targetCandidate - targetCandidate * fee) - (entryLimit + slip)
float riskQuantity = math.floor(strategy.equity * riskPct / 100 / lossPerShare)
float cashQuantity = math.floor(strategy.equity * allocationPct / 100 / entryLimit)
float volumeQuantity = not na(volume) ? math.floor(volume * maxBarParticipation / 100) : 0
float candidateQty = math.max(0, math.min(riskQuantity, math.min(cashQuantity, volumeQuantity)))
bool riskOK = ready and stopCandidate > slip and priceRisk > 0 and priceRisk <= atr * maxStopATR and priceRisk / entryLimit * 100 <= maxStopPct and targetCandidate - entryLimit <= atr * maxTargetATR and candidateQty >= 1

// ---------- Persistent trade plan ----------
var bool pending = false
var int submittedBar = na
var int entryBar = na
var int lastExitBar = na
var float planEntry = na
var float initialStop = na
var float liveStop = na
var float planTarget = na
var float planQty = na
var float planRisk = na
var float planReward = na
var float planPriceR = na
var bool raisedToBE = false

if filledNow
    pending := false
    entryBar := bar_index
if closedNow
    pending := false
    lastExitBar := bar_index

// Limit order is active for ONE following chart bar, including an overnight
// opening on 60m/1D. If still unfilled at that bar's close, cancel it.
bool expiredNow = pending and bar_index > submittedBar and not havePosition
bool cancelForGate = pending and (dayLocked or flattenSession or not inTest)
if expiredNow or cancelForGate
    strategy.cancel("L")
    strategy.cancel("BRACKET")
    pending := false
    alert("إلغاء أمر شراء غير منفّذ | " + syminfo.ticker, alert.freq_once_per_bar_close)

// No recalculation on fills. Existing bracket is active intrabar.
// Stop upgrades use confirmed CLOSE only and take effect on the next tick.
bool beNow = false
if havePosition and useBreakEven and not raisedToBE and close >= planEntry + 1.5 * planPriceR
    float beStop = f_up(strategy.position_avg_price * (1 + fee) / (1 - fee) + slip)
    if beStop > liveStop and beStop < close and beStop < planTarget
        liveStop := beStop
        raisedToBE := true
        beNow := true
        alert("رفع الوقف إلى نقطة التعادل | " + syminfo.ticker + " | الوقف " + f_price(liveStop), alert.freq_once_per_bar_close)

bool timedExit = havePosition and not na(entryBar) and bar_index - entryBar >= maxHoldingBars - 1
bool trendExit = havePosition and trendExitEnabled and close < ema20 and close[1] < ema20[1]
bool forceExit = havePosition and (dailyLossHit or flattenSession or not inTest or timedExit or trendExit)
if havePosition
    strategy.exit("BRACKET", "L", stop = liveStop, limit = planTarget, comment_loss = "وقف", comment_profit = "هدف", alert_message = "خروج بأمر مبرمج: وقف أو هدف")
if forceExit
    string why = dailyLossHit ? "بلوغ حد الخسارة اليومي" : flattenSession ? "نهاية جلسة المضاربة" : not inTest ? "خارج فترة الاختبار" : timedExit ? "خروج زمني" : "ضعف الاتجاه"
    strategy.close("L", comment = why, alert_message = "خروج اضطراري: " + why)
    alert("طلب خروج | " + syminfo.ticker + " | " + why, alert.freq_once_per_bar_close)

// Orders are submitted only after confirmation, never on the signal bar's
// historical high/low. No pyramiding and no entry on an exit/expiry bar.
bool cooldownOK = na(lastExitBar) or bar_index - lastExitBar > 2
bool submitSignal = barstate.isconfirmed and inTest and entryWindow and not flattenSession and not dayLocked and entriesToday < maxEntriesDay and not havePosition and not pending and not closedNow and not expiredNow and not cancelForGate and cooldownOK and setup and riskOK
if submitSignal
    entriesToday := entriesToday + 1
    planEntry := entryLimit
    initialStop := stopCandidate
    liveStop := stopCandidate
    planTarget := targetCandidate
    planQty := candidateQty
    planRisk := candidateQty * lossPerShare
    planReward := candidateQty * profitPerShare
    planPriceR := priceRisk
    raisedToBE := false
    submittedBar := bar_index
    pending := true
    strategy.entry("L", strategy.long, qty = planQty, limit = planEntry, alert_message = "شراء اختراق بأمر محدّد")
    strategy.exit("BRACKET", "L", stop = liveStop, limit = planTarget, comment_loss = "وقف", comment_profit = "هدف", alert_message = "خروج بأمر مبرمج: وقف أو هدف")
    alert("شراء مؤكّد | " + syminfo.ticker + " | كمية " + str.tostring(planQty, "#") + " | حد الشراء " + f_price(planEntry) + " | الوقف " + f_price(liveStop) + " | الهدف " + f_price(planTarget) + " | صالح للشمعة التالية فقط", alert.freq_once_per_bar_close)

// ---------- Display ----------
bool showLevels = pending or havePosition
plot(ema20, "EMA20", color = color.teal)
plot(ema50, "EMA50", color = color.orange)
plot(dayMode ? vwap : na, "VWAP يومي — 5 و15 دقيقة", color = color.purple)
plot(showLevels ? planEntry : na, "حد الدخول", color = color.blue, linewidth = 2, style = plot.style_linebr)
plot(showLevels ? liveStop : na, "وقف الخسارة", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(showLevels ? planTarget : na, "الهدف", color = color.lime, linewidth = 2, style = plot.style_linebr)
plotshape(submitSignal, title = "إشارة شراء مؤكّدة", style = shape.labelup, location = location.belowbar, color = color.green, text = "شراء", textcolor = color.white, size = size.small)
plotshape(closedNow, title = "خروج", style = shape.labeldown, location = location.abovebar, color = color.red, text = "بيع", textcolor = color.white, size = size.small)
plotshape(beNow, title = "رفع الوقف للتعادل", style = shape.circle, location = location.belowbar, color = color.aqua, size = size.tiny)
plotshape(expiredNow or cancelForGate, title = "إلغاء أمر معلّق", style = shape.xcross, location = location.belowbar, color = color.gray, size = size.tiny)
bgcolor(dayLocked ? color.new(color.red, 93) : na, title = "توقّف صفقات اليوم لهذا الشارت")

var table panel = table.new(position.top_right, 2, 13, border_width = 1)
if barstate.islast and showPanel
    string state = havePosition ? "صفقة مفتوحة" : pending ? "أمر معلّق — صالح لشمعة واحدة" : dayLocked ? "توقّف يومي — تجاوز حد الخسارة" : not inTest ? "خارج فترة الاختبار" : not ready ? "بيانات غير مكتملة" : not marketOK ? "تاسي لا يؤكّد الاتجاه" : not liquidityOK ? "السيولة أقل من الحد" : not entryWindow ? "خارج وقت الدخول" : not cooldownOK ? "فترة تهدئة بعد الخروج" : entriesToday >= maxEntriesDay ? "اكتمل عدد صفقات اليوم" : not setup ? "بانتظار شروط الدخول" : not riskOK ? "الوقف أو الكمية غير مناسبين" : "بانتظار"
    table.cell(panel, 0, 0, "Adil TrendRisk v1", bgcolor = color.navy, text_color = color.white)
    table.cell(panel, 1, 0, "محاكاة — SAR", bgcolor = color.navy, text_color = color.white)
    table.cell(panel, 0, 1, "الإطار / التأكيد", text_color = chart.fg_color)
    table.cell(panel, 1, 1, timeframe.period + " / " + higherTF, text_color = chart.fg_color)
    table.cell(panel, 0, 2, "الحالة", text_color = chart.fg_color)
    table.cell(panel, 1, 2, state, text_color = chart.fg_color)
    table.cell(panel, 0, 3, "حد الدخول الأعلى", text_color = chart.fg_color)
    table.cell(panel, 1, 3, showLevels ? f_price(planEntry) : "—", text_color = color.blue)
    table.cell(panel, 0, 4, "الوقف الحالي", text_color = chart.fg_color)
    table.cell(panel, 1, 4, showLevels ? f_price(liveStop) : "—", text_color = color.red)
    table.cell(panel, 0, 5, "الهدف", text_color = chart.fg_color)
    table.cell(panel, 1, 5, showLevels ? f_price(planTarget) : "—", text_color = color.green)
    table.cell(panel, 0, 6, "الكمية", text_color = chart.fg_color)
    table.cell(panel, 1, 6, showLevels ? str.tostring(planQty, "#") : "—", text_color = chart.fg_color)
    table.cell(panel, 0, 7, "الخسارة الأولية المقدّرة SAR", text_color = chart.fg_color)
    table.cell(panel, 1, 7, showLevels ? f_money(planRisk) : "—", text_color = color.red)
    table.cell(panel, 0, 8, "صافي الربح المتوقّع عند الهدف SAR", text_color = chart.fg_color)
    table.cell(panel, 1, 8, showLevels ? f_money(planReward) : "—", text_color = color.green)
    table.cell(panel, 0, 9, "صافي اليوم المحقّق SAR", text_color = chart.fg_color)
    table.cell(panel, 1, 9, f_money(dayRealized), text_color = dayRealized >= 0 ? color.green : color.red)
    table.cell(panel, 0, 10, "حد الخسارة اليومي SAR", text_color = chart.fg_color)
    table.cell(panel, 1, 10, f_money(dayLossBudget), text_color = chart.fg_color)
    table.cell(panel, 0, 11, "صفقات اليوم / هدف اليوم", text_color = chart.fg_color)
    table.cell(panel, 1, 11, str.tostring(entriesToday) + " / " + (dayMode ? f_money(dayGoal) : "هدف مفتوح"), text_color = chart.fg_color)
    table.cell(panel, 0, 12, "رأس المال الافتراضي", text_color = chart.fg_color)
    table.cell(panel, 1, 12, f_money(strategy.equity), text_color = chart.fg_color)
